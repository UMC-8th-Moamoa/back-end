// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              Int      @id @default(autoincrement())
  user_id         String   @unique
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  password        String
  birthday        DateTime?
  cash            Int      @default(0)
  phone           String?
  photo           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastLoginAt     DateTime?

  // Relations
  socialLogins                   SocialLogin[]
  sentFriendRequests             Friend[]      @relation("RequesterFriend")
  receivedFriendRequests         Friend[]      @relation("ReceiverFriend")
  followers                      Follow[]      @relation("FollowerUser")
  following                      Follow[]      @relation("FollowingUser")
  notifications                  Notification[]
  wishlists                      Wishlist[]
  birthdayEventsAsBirthdayPerson BirthdayEvent[] @relation("BirthdayPersonEvents")
  birthdayEventsAsCreator        BirthdayEvent[] @relation("CreatorEvents")
  birthdayEventParticipations    BirthdayEventParticipant[]
  pointHistories                 PointHistory[]
  advertisements                 Advertisement[]
  userItems                      UserItem[]
  paymentInfos                   PaymentInfo[]
  sentLetters                    Letter[]      @relation("SentLetters")
  receivedLetters                Letter[]      @relation("ReceivedLetters")

  @@map("users")
}

model SocialLogin {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String
  provider  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("social_logins")
}

model Friend {
  id          Int           @id @default(autoincrement())
  requesterId Int
  receiverId  Int
  status      FriendStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  acceptedAt  DateTime?

  requester User @relation("RequesterFriend", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User @relation("ReceiverFriend", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@map("friends")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())

  follower  User @relation("FollowerUser", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowingUser", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  message   String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Wishlist {
  id               Int      @id @default(autoincrement())
  userId           Int
  productImageUrl  String
  productName      String
  price            Int
  fundingActive    Boolean  @default(false)
  isPublic         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthdayEvents BirthdayEvent[]
  analysisRequests WishlistAnalysisRequest[]

  @@map("wishlists")
}

model BirthdayEvent {
  id               Int      @id @default(autoincrement())
  wishlistId       Int
  birthdayPersonId Int
  creatorId        Int
  title            String
  targetAmount     Int
  currentAmount    Int      @default(0)
  deadline         DateTime
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  wishlist         Wishlist                   @relation(fields: [wishlistId], references: [id])
  birthdayPerson   User                       @relation("BirthdayPersonEvents", fields: [birthdayPersonId], references: [id])
  creator          User                       @relation("CreatorEvents", fields: [creatorId], references: [id])
  participants     BirthdayEventParticipant[]
  letters          Letter[]
  purchaseProof    PurchaseProof?

  @@map("birthday_events")
}

model BirthdayEventParticipant {
  id        Int      @id @default(autoincrement())
  eventId   Int
  userId    Int
  amount    Int
  message   String?
  createdAt DateTime @default(now())

  event BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("birthday_event_participants")
}

model WishlistAnalysisRequest {
  id          Int                    @id @default(autoincrement())
  wishlistId  Int
  insertType  WishlistAnalysisType
  inputData   String
  createdAt   DateTime               @default(now())
  completedAt DateTime?

  wishlist Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@map("wishlist_analysis_requests")
}

model BankTransfer {
  id             Int      @id @default(autoincrement())
  bankName       String
  accountNumber  String
  depositorName  String
  createdAt      DateTime @default(now())

  pointHistories PointHistory[]
  paymentInfos   PaymentInfo[]

  @@map("bank_transfers")
}

model PointHistory {
  id             Int           @id @default(autoincrement())
  userId         Int
  pointType      PointType
  pointChange    Int
  description    String
  totalPoints    Int
  bankTransferId Int?
  createdAt      DateTime      @default(now())

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankTransfer BankTransfer?  @relation(fields: [bankTransferId], references: [id])
  advertisement Advertisement?
  userItems    UserItem[]

  @@map("point_histories")
}

model Advertisement {
  id             Int      @id @default(autoincrement())
  pointHistoryId Int      @unique
  userId         Int
  adUrl          String
  duration       Int
  playCount      Int      @default(1)
  costPerPlay    Int      @default(1)
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime @default(now())

  pointHistory PointHistory @relation(fields: [pointHistoryId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@map("advertisements")
}

model Item {
  id          Int          @id @default(autoincrement())
  category    ItemCategory
  name        String
  price       Int
  imageUrl    String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  userItems UserItem[]

  @@map("items")
}

model UserItem {
  id             Int      @id @default(autoincrement())
  userId         Int
  itemId         Int
  pointHistoryId Int
  purchasedAt    DateTime @default(now())

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  item                Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pointHistory        PointHistory @relation(fields: [pointHistoryId], references: [id])
  lettersAsLetterPaper Letter[]    @relation("LetterPaper")
  lettersAsEnvelope   Letter[]     @relation("Envelope")

  @@unique([userId, itemId])
  @@map("user_items")
}

model PaymentInfo {
  id             Int           @id @default(autoincrement())
  userId         Int
  bankTransferId Int?
  amount         Int
  paymentMethod  PaymentMethod
  externalKey    String?
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankTransfer BankTransfer? @relation(fields: [bankTransferId], references: [id])

  @@map("payment_infos")
}

model Letter {
  id               Int      @id @default(autoincrement())
  birthdayEventId  Int?
  senderId         Int
  receiverId       Int
  title            String
  content          String
  letterPaperId    Int?
  envelopeId       Int?
  envelopeImageUrl String?
  sentAt           DateTime @default(now())
  readAt           DateTime?
  createdAt        DateTime @default(now())

  birthdayEvent BirthdayEvent? @relation(fields: [birthdayEventId], references: [id])
  sender        User           @relation("SentLetters", fields: [senderId], references: [id])
  receiver      User           @relation("ReceivedLetters", fields: [receiverId], references: [id])
  letterPaper   UserItem?      @relation("LetterPaper", fields: [letterPaperId], references: [id])
  envelope      UserItem?      @relation("Envelope", fields: [envelopeId], references: [id])

  @@map("letters")
}

model PurchaseProof {
  id              Int      @id @default(autoincrement())
  birthdayEventId Int      @unique
  proofImages     String   // JSON string for SQLite
  message         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  birthdayEvent BirthdayEvent @relation(fields: [birthdayEventId], references: [id], onDelete: Cascade)

  @@map("purchase_proofs")
}

// Enums
enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum NotificationType {
  FOLLOW_REQUEST
  BIRTHDAY_REMINDER
  PRIVATE_EVENT
}

enum WishlistAnalysisType {
  URL
  IMAGE
}

enum PointType {
  CHARGE
  USE
  ADVERTISEMENT
  ITEM_PURCHASE
}

enum ItemCategory {
  FONT
  LETTER_PAPER
  STICKER
}

enum PaymentMethod {
  BANK_TRANSFER
  KAKAO_PAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}