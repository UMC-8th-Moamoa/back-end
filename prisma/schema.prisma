generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                                               Int                        @id @default(autoincrement())
  user_id                                          String                     @unique @db.VarChar(50)
  name                                             String                     @db.VarChar(50)
  email                                            String                     @unique @db.VarChar(100)
  emailVerified                                    Boolean                    @default(false)
  password                                         String                     @db.VarChar(255)
  birthday                                         DateTime?
  cash                                             Int                        @default(0)
  phone                                            String?                    @db.VarChar(20)
  photo                                            String?                    @db.VarChar(255)
  createdAt                                        DateTime                   @default(now())
  updatedAt                                        DateTime                   @updatedAt
  lastLoginAt                                      DateTime?
  advertisements                                   Advertisement[]
  eventParticipants                                BirthdayEventParticipant[]
  birthdayEvents                                   BirthdayEvent[]            @relation("BirthdayPerson")
  birthday_events_birthday_events_creatorIdTousers BirthdayEvent[]            @relation("birthday_events_creatorIdTousers")
  following                                        Follow[]                   @relation("Follower")
  followers                                        Follow[]                   @relation("Following")
  friends_friends_receiverIdTousers                friends[]                  @relation("friends_receiverIdTousers")
  friends_friends_requesterIdTousers               friends[]                  @relation("friends_requesterIdTousers")
  receivedLetters                                  Letter[]                   @relation("LetterReceiver")
  sentLetters                                      Letter[]                   @relation("LetterSender")
  notifications                                    Notification[]
  paymentInfos                                     PaymentInfo[]
  pointHistories                                   PointHistory[]
  socialLogins                                     SocialLogin[]
  userItems                                        UserItem[]
  wishlists                                        Wishlist[]

  @@map("users")
}

model SocialLogin {
  id        Int      @id @default(autoincrement())
  user_id   String   @db.VarChar(50)
  token     String   @db.Text
  provider  String   @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id], map: "social_logins_user_id_fkey")
  @@map("social_logins")
}

model Follow {
  id          Int      @id @default(autoincrement())
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId], map: "follows_followingId_fkey")
  @@map("follows")
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  type      notifications_type
  title     String             @db.VarChar(100)
  message   String?            @db.Text
  isRead    Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "notifications_userId_fkey")
  @@map("notifications")
}

model Wishlist {
  id               Int                       @id @default(autoincrement())
  userId           Int
  productImageUrl  String                    @db.VarChar(255)
  productName      String                    @db.VarChar(100)
  price            Int
  fundingActive    Boolean                   @default(false)
  isPublic         Boolean                   @default(true)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  birthday_events  BirthdayEvent[]
  analysisRequests WishlistAnalysisRequest[]
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "wishlists_userId_fkey")
  @@map("wishlists")
}

model BirthdayEvent {
  id                                     Int                        @id @default(autoincrement())
  wishlistId                             Int
  birthdayPersonId                       Int
  creatorId                              Int
  title                                  String                     @db.VarChar(100)
  targetAmount                           Int
  currentAmount                          Int                        @default(0)
  deadline                               DateTime
  status                                 String                     @default("active") @db.VarChar(20)
  createdAt                              DateTime                   @default(now())
  updatedAt                              DateTime                   @updatedAt
  participants                           BirthdayEventParticipant[]
  birthdayPerson                         User                       @relation("BirthdayPerson", fields: [birthdayPersonId], references: [id])
  users_birthday_events_creatorIdTousers User                       @relation("birthday_events_creatorIdTousers", fields: [creatorId], references: [id])
  wishlists                              Wishlist                   @relation(fields: [wishlistId], references: [id])
  shareTokens                            EventShareToken[]
  letters                                Letter[]
  purchaseProof                          PurchaseProof?

  @@index([birthdayPersonId], map: "birthday_events_birthdayPersonId_fkey")
  @@index([creatorId], map: "birthday_events_creatorId_fkey")
  @@index([wishlistId], map: "birthday_events_wishlistId_fkey")
  @@map("birthday_events")
}

model BirthdayEventParticipant {
  id        Int           @id @default(autoincrement())
  eventId   Int
  userId    Int
  amount    Int
  message   String?       @db.Text
  createdAt DateTime      @default(now())
  event     BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@index([userId], map: "birthday_event_participants_userId_fkey")
  @@map("birthday_event_participants")
}

model WishlistAnalysisRequest {
  id          Int        @id @default(autoincrement())
  wishlistId  Int
  insertType  InsertType
  inputData   String     @db.Text
  createdAt   DateTime   @default(now())
  completedAt DateTime?
  wishlist    Wishlist   @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@index([wishlistId], map: "wishlist_analysis_requests_wishlistId_fkey")
  @@map("wishlist_analysis_requests")
}

model BankTransfer {
  id             Int            @id @default(autoincrement())
  bankName       String         @db.VarChar(50)
  accountNumber  String         @db.VarChar(50)
  depositorName  String         @db.VarChar(50)
  createdAt      DateTime       @default(now())
  paymentInfos   PaymentInfo[]
  pointHistories PointHistory[]

  @@map("bank_transfers")
}

model PointHistory {
  id             Int             @id @default(autoincrement())
  userId         Int
  pointType      PointType
  pointChange    Int
  description    String          @db.VarChar(255)
  totalPoints    Int
  bankTransferId Int?
  createdAt      DateTime        @default(now())
  advertisements Advertisement[]
  bankTransfer   BankTransfer?   @relation(fields: [bankTransferId], references: [id])
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userItems      UserItem[]

  @@index([bankTransferId], map: "point_histories_bankTransferId_fkey")
  @@index([userId], map: "point_histories_userId_fkey")
  @@map("point_histories")
}

model Advertisement {
  id             Int          @id @default(autoincrement())
  pointHistoryId Int
  userId         Int
  adUrl          String       @db.VarChar(255)
  duration       Int
  playCount      Int          @default(1)
  costPerPlay    Int          @default(1)
  startTime      DateTime
  endTime        DateTime
  createdAt      DateTime     @default(now())
  pointHistory   PointHistory @relation(fields: [pointHistoryId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@index([pointHistoryId], map: "advertisements_pointHistoryId_fkey")
  @@index([userId], map: "advertisements_userId_fkey")
  @@map("advertisements")
}

model Item {
  id          Int          @id @default(autoincrement())
  category    ItemCategory
  name        String       @db.VarChar(100)
  price       Int
  imageUrl    String       @db.VarChar(255)
  description String?      @db.Text
  event       Boolean
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  userItems   UserItem[]

  @@map("items")
}

model UserItem {
  id                   Int          @id @default(autoincrement())
  userId               Int
  itemId               Int
  pointHistoryId       Int
  purchasedAt          DateTime     @default(now())
  lettersAsEnvelope    Letter[]     @relation("LetterEnvelope")
  lettersAsLetterPaper Letter[]     @relation("LetterPaper")
  item                 Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  pointHistory         PointHistory @relation(fields: [pointHistoryId], references: [id])
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([itemId], map: "user_items_itemId_fkey")
  @@index([pointHistoryId], map: "user_items_pointHistoryId_fkey")
  @@map("user_items")
}

model PaymentInfo {
  id             Int           @id @default(autoincrement())
  userId         Int
  bankTransferId Int?
  amount         Int
  paymentMethod  PaymentMethod
  externalKey    String?       @db.VarChar(255)
  status         PaymentStatus @default(PENDING)
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now())
  bankTransfer   BankTransfer? @relation(fields: [bankTransferId], references: [id])
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bankTransferId], map: "payment_infos_bankTransferId_fkey")
  @@index([userId], map: "payment_infos_userId_fkey")
  @@map("payment_infos")
}

model Letter {
  id               Int            @id @default(autoincrement())
  birthdayEventId  Int?
  senderId         Int
  receiverId       Int
  title            String         @db.VarChar(100)
  content          String         @db.Text
  letterPaperId    Int?
  envelopeId       Int?
  envelopeImageUrl String?        @db.VarChar(500)
  sentAt           DateTime       @default(now())
  readAt           DateTime?
  createdAt        DateTime       @default(now())
  birthdayEvent    BirthdayEvent? @relation(fields: [birthdayEventId], references: [id])
  envelope         UserItem?      @relation("LetterEnvelope", fields: [envelopeId], references: [id])
  letterPaper      UserItem?      @relation("LetterPaper", fields: [letterPaperId], references: [id])
  receiver         User           @relation("LetterReceiver", fields: [receiverId], references: [id])
  sender           User           @relation("LetterSender", fields: [senderId], references: [id])

  @@index([birthdayEventId], map: "letters_birthdayEventId_fkey")
  @@index([envelopeId], map: "letters_envelopeId_fkey")
  @@index([letterPaperId], map: "letters_letterPaperId_fkey")
  @@index([receiverId], map: "letters_receiverId_fkey")
  @@index([senderId], map: "letters_senderId_fkey")
  @@map("letters")
}

model PurchaseProof {
  id              Int           @id @default(autoincrement())
  birthdayEventId Int           @unique
  proofImages     Json
  message         String        @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  birthdayEvent   BirthdayEvent @relation(fields: [birthdayEventId], references: [id], onDelete: Cascade)

  @@map("purchase_proofs")
}

model EventShareToken {
  id        Int           @id @default(autoincrement())
  eventId   Int
  token     String        @unique @db.VarChar(255)
  expiresAt DateTime
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  event     BirthdayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "event_share_tokens_eventId_fkey")
  @@map("event_share_tokens")
}

model friends {
  id                               Int            @id @default(autoincrement())
  requesterId                      Int
  receiverId                       Int
  status                           friends_status @default(PENDING)
  createdAt                        DateTime       @default(now())
  acceptedAt                       DateTime?
  users_friends_receiverIdTousers  User           @relation("friends_receiverIdTousers", fields: [receiverId], references: [id], onDelete: Cascade)
  users_friends_requesterIdTousers User           @relation("friends_requesterIdTousers", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, receiverId])
  @@index([receiverId], map: "friends_receiverId_fkey")
}

enum PointType {
  CHARGE
  USE
  ADVERTISEMENT
  ITEM_PURCHASE
}

enum PaymentMethod {
  BANK_TRANSFER
  KAKAO_PAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InsertType {
  URL
  IMAGE
}

enum ItemCategory {
  font
  paper
  envelope
}

enum notifications_type {
  FOLLOW_REQUEST
  BIRTHDAY_REMINDER
  PRIVATE_EVENT
}

enum friends_status {
  PENDING
  ACCEPTED
  BLOCKED
}
