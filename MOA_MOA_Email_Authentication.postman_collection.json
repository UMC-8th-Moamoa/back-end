{
  "info": {
    "name": "MOA MOA Email Authentication",
    "description": "이메일 인증 시스템 테스트",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. 이메일 중복 확인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/email/check",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "email", "check"]
        }
      }
    },
    {
      "name": "2. 이메일 인증 코드 발송 (회원가입)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"your-email@gmail.com\",\n  \"purpose\": \"signup\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/email/verify-email",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "email", "verify-email"]
        }
      }
    },
    {
      "name": "3. 이메일 인증 코드 확인",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"code\": \"123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/email/send-code",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "email", "send-code"]
        }
      }
    },
    {
      "name": "4. 이메일 인증 코드 발송 (비밀번호 재설정)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"existing-user@gmail.com\",\n  \"purpose\": \"reset\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/email/verify-email",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "email", "verify-email"]
        }
      }
    },
    {
      "name": "5. 아이디 찾기",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"existing-user@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/find-id",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "find-id"]
        }
      }
    },
    {
      "name": "6. 비밀번호 재설정 요청",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"existing-user@gmail.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/users/find-password",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "find-password"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ]
}
